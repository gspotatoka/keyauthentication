# --- set these in Vercel > Project > Settings > Environment Variables ---
# Long random string you choose. Used to log in to /admin.
ADMIN_TOKEN=change-me-to-a-long-random-string
# From `npm run keypair`  (keep PRIVATE secret, put PUBLIC into the Python client)
LICENSE_PRIVATE_SEED=
# Added automatically when you connect an Upstash Redis store from the Vercel Marketplace
# (either naming scheme works):
KV_REST_API_URL=
KV_REST_API_TOKEN=
